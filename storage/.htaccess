# Logy a HTML dumpy Tracy: zdrojovy kod, promenne a stav requestu.
# Adresar je mimo document root, tohle je pojistka pro spatne nastaveny hosting.
Options -Indexes

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|js|css|svg|webp)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
</IfModule>
Options -Indexes
RewriteEngine On

# ----------------------------------------------------------------------
# 1. PŘESMĚROVÁNÍ NA HTTPS (Volitelné - doporučeno)
# Pokud web neběží na localhostu a není HTTPS, přesměruj
# ----------------------------------------------------------------------
# RewriteCond %{HTTP_HOST} !=localhost
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Drop a trailing slash. The captured path must not start with a slash or a
# backslash: the previous rule, ^(.*)/$ -> /$1, turned a request for
# //evil.com/ into Location: //evil.com, which a browser follows off-site.
#
# $1 rather than %{REQUEST_URI}, because $1 is relative to this directory. When
# the document root is the project root, the root .htaccess has already
# rewritten the request to public/..., and REQUEST_URI would carry that prefix
# into the redirect.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/\\].*?)/+$ /$1 [L,R=301]

RewriteCond %{REQUEST_FILENAME} !-f

RewriteCond %{REQUEST_FILENAME} !-d

RewriteRule ^ index.php [QSA,L]

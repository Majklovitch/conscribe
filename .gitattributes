# Line endings.
#
# The repository stores LF. Without this file, core.autocrlf=true checks PHP
# out as CRLF on Windows, php-cs-fixer rewrites it back to LF, and every run
# after a checkout or a merge reports dozens of files as needing a fix that
# git then normalizes away - which makes `composer fix:check` useless as a
# check. Pinning the working-tree ending keeps the two tools agreeing.
* text=auto

*.php    text eol=lf
*.neon   text eol=lf
*.xml    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.scss   text eol=lf
*.js     text eol=lf
*.yml    text eol=lf

*.png    binary
*.jpg    binary
*.webp   binary
*.ico    binary
*.woff   binary
*.woff2  binary

# The console entry points have no extension, the way `artisan` and
# `bin/console` have none, so the rules above do not reach them. A CRLF in a
# shebang line makes the script unrunnable as ./tty on a Unix host.
tty      text eol=lf
bin/tty  text eol=lf

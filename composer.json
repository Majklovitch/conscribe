{
    "name": "majklovitch/conscribe-php",
    "description": "Conscribe MVC framework",
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "app/Modules/"
        },
        "files": [
            "app/Helpers/TemplateHelper.php"
        ]
    },
    "authors": [
        {
            "name": "Majklovitch",
            "email": "mbrotys@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-gd": "*",
        "phpmailer/phpmailer": "^7.1",
        "monolog/monolog": "^3.10",
        "tracy/tracy": "^2.10",
        "scssphp/scssphp": "^2.0",
        "matthiasmullie/minify": "^1.3"
    },
    "suggest": {
        "ext-imagick": "Preferred image driver for MediaService; GD is used as a fallback.",
        "ext-exif": "Corrects rotated JPEG photos when the GD driver is used."
    },
    "config": {
        "optimize-autoloader": true
    },
    "scripts": {
        "build": "php bin/build.php --env=production",
        "build:dev": "php bin/build.php --env=development",
        "build:watch": "php bin/build.php --env=development --watch",
        "lint": "php bin/lint.php"
    },
    "scripts-descriptions": {
        "build": "Compile SCSS and minify JS into public/ (production output).",
        "build:dev": "Compile assets with expanded CSS and a source map.",
        "build:watch": "Rebuild assets whenever a file under assets/ changes."
    },
    "require-dev": {
        "phpstan/phpstan": "*",
        "phpunit/phpunit": "*",
        "friendsofphp/php-cs-fixer": "*",
        "symfony/var-dumper": "*"
    }
}
